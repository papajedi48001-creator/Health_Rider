# HTTPS in front of Health Rider for a LAN or staging host.
# Rider phones need HTTPS for the camera, the service worker and offline mode.
# `tls internal` issues certificates from Caddy's own CA; install that CA's root
# certificate on each phone once (see docs/operations/https-staging.md).
{
	admin off
}

{$HTTPS_HOST:localhost} {
	tls internal
	encode gzip
	request_body {
		# Delivered-attempt syncs carry an evidence photo.
		max_size 10MB
	}
	reverse_proxy {$UPSTREAM:web:3000}
}
