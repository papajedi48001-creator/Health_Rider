# HTTPS in front of Health Rider for a LAN or staging host.
# Rider phones need HTTPS for the camera, the service worker and offline mode.
# `tls internal` issues certificates from Caddy's own CA; install that CA's root
# certificate on each phone once (see docs/operations/https-staging.md).
{
	admin off
	# Phones opening https://<IP> send no SNI, and inside Docker the connection's local IP is the
	# container's, not HTTPS_HOST, so Caddy must be told which certificate to present.
	default_sni {$HTTPS_HOST:localhost}
}

{$HTTPS_HOST:localhost} {
	tls internal
	encode gzip
	header {
		# Phones that have opened the site over HTTPS keep using HTTPS. Kept to 30 days because the
		# certificate comes from Caddy's own CA on a LAN host.
		Strict-Transport-Security "max-age=2592000"
	}
	request_body {
		# Delivered-attempt syncs carry an evidence photo.
		max_size 10MB
	}
	reverse_proxy {$UPSTREAM:web:3000}
}
