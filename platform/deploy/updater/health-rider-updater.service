[Unit]
Description=Health Rider updater: installs versions an admin chose on the "อัปเดตระบบ" page
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/health-rider-updater.env
ExecStart=/usr/bin/python3 /usr/local/lib/health-rider-updater/health-rider-updater.py
# A rebuild can take several minutes; the job itself gives up on a version after HR_HEALTH_TIMEOUT.
TimeoutStartSec=45min
