# Copy to .env.production on the app server and fill in. Never commit the filled file.
# Health Rider database on the hospital MariaDB server (a separate database, not the HOSxP schema).
DATABASE_URL="mysql://health_rider:REPLACE-WITH-LONG-RANDOM-PASSWORD@192.168.1.254:3306/health_rider"
# Random value of at least 32 characters: openssl rand -base64 48
AUTH_SECRET=""
# Served at https://waritch-hosp.moph.go.th/health-rider. Rebuild the image after changing it.
NEXT_PUBLIC_BASE_PATH="/health-rider"
# Read-only HOSxP account, and the drug item codes that may be delivered.
HOS_DATABASE_URL=""
HOS_ELIGIBLE_ITEM_CODES=""
# Leave empty when the reverse proxy runs on this machine; otherwise e.g. "192.168.1.50:3000".
WEB_PUBLISH=""
# Private range for the app's Docker network; must not overlap the hospital network or other Docker networks.
DOCKER_SUBNET="10.250.252.0/24"
