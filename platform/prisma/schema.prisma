generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  pharmacy
  coordinator
  rider
  admin
  auditor
}

enum EmploymentCategory {
  internal
  external
}

enum DeliveryAttemptStatus {
  prepared
  claimed
  in_transit
  delivered
  delivery_failed
  return_required
  returned
  sync_review
}

model User {
  id                String            @id @db.Char(26)
  username          String            @unique @db.VarChar(100)
  passwordHash      String            @db.VarChar(255)
  displayName       String            @db.VarChar(255)
  role              UserRole
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  riderProfile      RiderProfile?
  claimedAttempts   DeliveryAttempt[] @relation("ClaimedAttempts")
  createdRequests   DeliveryRequest[] @relation("CreatedRequests")
  sessions          Session[]

  @@map("users")
}

model Session {
  id         String    @id @db.Char(26)
  tokenHash  String    @unique @db.Char(64)
  userId     String    @db.Char(26)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model RiderProfile {
  id                 String             @id @db.Char(26)
  userId             String             @unique @db.Char(26)
  riderCode          String             @unique @db.VarChar(100)
  employmentCategory EmploymentCategory
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id])

  @@map("rider_profiles")
}

model DeliveryZone {
  id              String            @id @db.Char(26)
  subdistrictCode String            @db.VarChar(32)
  villageCode     String            @db.VarChar(32)
  displayName     String            @db.VarChar(255)
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  requests        DeliveryRequest[]

  @@unique([subdistrictCode, villageCode])
  @@map("delivery_zones")
}

model EligibilityRule {
  id          String   @id @db.Char(26)
  name        String   @unique @db.VarChar(255)
  enabled     Boolean  @default(true)
  definition  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("eligibility_rules")
}

model DeliveryRequest {
  id                 String            @id @db.Char(26)
  hosVisitNumber     String?           @unique @db.VarChar(100)
  hn                 String            @db.VarChar(100)
  patientName        String            @db.VarChar(255)
  patientAge         Int?
  telephone          String?           @db.VarChar(100)
  deliveryAddress    String            @db.Text
  deliveryZoneId     String            @db.Char(26)
  deliveryVersion    Int               @default(1)
  createdById        String            @db.Char(26)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deliveryZone       DeliveryZone      @relation(fields: [deliveryZoneId], references: [id])
  createdBy          User              @relation("CreatedRequests", fields: [createdById], references: [id])
  attempts           DeliveryAttempt[]

  @@index([hn, createdAt])
  @@map("delivery_requests")
}

model DeliveryAttempt {
  id                String                @id @db.Char(26)
  deliveryRequestId String                @db.Char(26)
  riderId           String?               @db.Char(26)
  status            DeliveryAttemptStatus @default(prepared)
  claimedAt         DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  failureReason     String?               @db.VarChar(100)
  returnedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deliveryRequest   DeliveryRequest       @relation(fields: [deliveryRequestId], references: [id])
  rider             User?                 @relation("ClaimedAttempts", fields: [riderId], references: [id])
  qrTokens          PackageQrToken[]
  evidence          DeliveryEvidence?
  offlineEvents     OfflineDeliveryEvent[]
  syncConflicts     SyncConflict[]

  @@index([deliveryRequestId, createdAt])
  @@index([status, createdAt])
  @@map("delivery_attempts")
}

model PackageQrToken {
  id                String          @id @db.Char(26)
  deliveryAttemptId String          @db.Char(26)
  tokenHash         String          @unique @db.Char(64)
  expiresAt         DateTime
  invalidatedAt     DateTime?
  createdAt         DateTime        @default(now())
  deliveryAttempt   DeliveryAttempt @relation(fields: [deliveryAttemptId], references: [id])

  @@map("package_qr_tokens")
}

model DeliveryEvidence {
  id                String          @id @db.Char(26)
  deliveryAttemptId String          @unique @db.Char(26)
  recipientRelation String          @db.VarChar(100)
  photoPath         String          @db.VarChar(1024)
  deviceCapturedAt  DateTime
  serverReceivedAt  DateTime        @default(now())
  createdAt         DateTime        @default(now())
  deliveryAttempt   DeliveryAttempt @relation(fields: [deliveryAttemptId], references: [id])

  @@map("delivery_evidence")
}

model OfflineDeliveryEvent {
  id                  String          @id @db.Char(26)
  eventUuid           String          @db.Char(36)
  deliveryAttemptId   String          @db.Char(26)
  riderId             String          @db.Char(26)
  deliveryVersion     Int
  eventType           String          @db.VarChar(100)
  payload             Json
  deviceCapturedAt    DateTime
  serverReceivedAt    DateTime        @default(now())
  createdAt           DateTime        @default(now())
  deliveryAttempt     DeliveryAttempt @relation(fields: [deliveryAttemptId], references: [id])
  syncConflict        SyncConflict?

  @@unique([eventUuid, riderId])
  @@map("offline_delivery_events")
}

model SyncConflict {
  id                     String                @id @db.Char(26)
  offlineDeliveryEventId String                @unique @db.Char(26)
  deliveryAttemptId      String                @db.Char(26)
  reason                 String                @db.VarChar(50)
  previousStatus         DeliveryAttemptStatus
  status                 String                @default("pending") @db.VarChar(50)
  outcome                String?               @db.VarChar(50)
  resolution             String?               @db.Text
  resolvedById           String?               @db.Char(26)
  resolvedAt             DateTime?
  createdAt              DateTime              @default(now())
  offlineDeliveryEvent   OfflineDeliveryEvent  @relation(fields: [offlineDeliveryEventId], references: [id])
  deliveryAttempt        DeliveryAttempt       @relation(fields: [deliveryAttemptId], references: [id])

  @@index([status, createdAt])

  @@map("sync_conflicts")
}

model AuditEvent {
  id            String   @id @db.Char(26)
  actorId       String   @db.Char(26)
  action        String   @db.VarChar(255)
  auditableType String   @db.VarChar(100)
  auditableId   String   @db.Char(26)
  reason        String?  @db.Text
  oldValues     Json?
  newValues     Json?
  createdAt     DateTime @default(now())

  @@index([auditableType, auditableId, createdAt])
  @@map("audit_events")
}
