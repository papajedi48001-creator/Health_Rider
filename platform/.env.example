DATABASE_URL="mysql://health_rider:replace-for-local-development@db:3306/health_rider"
HOS_DATABASE_URL=""
HOS_ELIGIBLE_ITEM_CODES=""
# Random value of at least 32 characters, for example: openssl rand -base64 48
AUTH_SECRET=""
EVIDENCE_STORAGE_PATH="/app/data/evidence"
# Staging over plain HTTP on a LAN address only: "true" drops the Secure cookie flag. Leave empty behind HTTPS.
SESSION_COOKIE_INSECURE=""
# Where the web port is published. Default 127.0.0.1:3000 keeps plain HTTP on this machine only.
# Set to 3000 only for a temporary HTTP test from other LAN devices; never in production.
WEB_PUBLISH=""
MARIADB_DATABASE="health_rider"
MARIADB_USER="health_rider"
# Required: compose refuses to start without them. Use long random values outside local development.
MARIADB_PASSWORD="replace-for-local-development"
MARIADB_ROOT_PASSWORD="replace-for-local-development"
# UAT seeding only: password for every *.uat account (at least 12 characters) and an optional zone CSV path.
SEED_UAT_PASSWORD=""
SEED_ZONES_FILE=""

# Optional HTTPS for rider phones: `docker compose --profile https up -d`.
# HTTPS_HOST is the address phones open, e.g. the PC's LAN IP; HTTPS_PORT defaults to 443.
HTTPS_HOST=""
HTTPS_PORT=""
